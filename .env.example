# ============================================================
# 复制为 .env 后填写。.env 不进 Git（见 .gitignore）。
# 原则：密钥只存在于环境变量，代码里不出现。
# ============================================================

ENVIRONMENT=dev

# --- 数据库 / 队列 ---
# 与本机 docker-compose.yml 的凭据对应（仅供本地 dev）
DATABASE_URL=postgresql+psycopg://logagent:logagent_dev_pw@127.0.0.1:5432/logagent
REDIS_URL=redis://127.0.0.1:6379/0

# --- 会话密钥 ---
SECRET_KEY=change-me

# --- 模型等级 → 具体型号的映射 ---
# 业务代码只认 L1 / L2 / L3，型号只在这里出现。
# 下面留空是有意的：阶段 06 之前必须由你填入真实型号与端点。
MODEL_L1=
MODEL_L2=
MODEL_L3=
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_API_KEY=

# --- 成本单价（[计划补充项] 原文只说「自行填入配置」，未给配置项）---
# 单位：元 / 每 1M token。以所用模型官方现价为准，随模型迭代更新。
MODEL_L1_PRICE_INPUT_PER_1M=0
MODEL_L1_PRICE_OUTPUT_PER_1M=0
MODEL_L2_PRICE_INPUT_PER_1M=0
MODEL_L2_PRICE_OUTPUT_PER_1M=0
MODEL_L3_PRICE_INPUT_PER_1M=0
MODEL_L3_PRICE_OUTPUT_PER_1M=0

# --- 预算 ---
# 货币单位自定，与上面单价保持一致即可（默认按人民币）
MONTHLY_BUDGET=10
DEFAULT_RUN_MAX_COST=0.30

# --- 时间 / 日志 ---
# 时间戳缺时区时按此解析，再转 UTC 存储
DEFAULT_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
